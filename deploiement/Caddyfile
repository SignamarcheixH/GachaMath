# Caddy obtient et renouvelle le certificat Let's Encrypt tout seul, à la
# seule condition que le DNS pointe déjà sur cette machine. Ne lancez pas
# Caddy avant que « dig gachamath.fr » réponde la bonne adresse : les échecs
# de validation sont limités en nombre chez Let's Encrypt.

# Une seule adresse canonique. Sans cette redirection, le site existerait à
# deux adresses pour un moteur de recherche, qui répartirait le crédit de
# l'une entre les deux.
www.gachamath.fr {
	redir https://gachamath.fr{uri} permanent
}

gachamath.fr {
	encode zstd gzip

	# Caddy pose lui-même X-Forwarded-Proto, ce dont Django a besoin pour
	# savoir que la connexion d'origine était en HTTPS. Sans cela, sa
	# redirection vers HTTPS tournerait en boucle infinie.
	reverse_proxy 127.0.0.1:8000

	log {
		output file /var/log/caddy/gachamath.log
		# Les journaux servent au diagnostic, pas au profilage : la page de
		# confidentialité annonce trente jours, on s'y tient.
		format json
	}
}
