# Copier vers /srv/gachamath/.env, puis : chmod 600 /srv/gachamath/.env
# Ce fichier contient la clé de signature des cookies. Il ne doit jamais
# entrer dans git — le .gitignore l'exclut déjà.

# Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=a-remplacer-par-une-vraie-cle

DJANGO_DEBUG=0
DJANGO_HOSTS=gachamath.fr,www.gachamath.fr
DJANGO_ORIGINES=https://gachamath.fr,https://www.gachamath.fr

# HSTS. On démarre à une heure le temps de vérifier que le certificat se
# renouvelle bien, puis on passe à 31536000 (un an). Ne montez pas tout de
# suite : un navigateur qui a mémorisé la durée refusera le HTTP pendant
# tout ce temps, même si le site devient injoignable en HTTPS.
DJANGO_HSTS=3600

# Sauvegardes
SQLITE_CHEMIN=/srv/gachamath/serveur/db.sqlite3
SAUVEGARDES=/srv/gachamath/sauvegardes
SAUVEGARDES_GARDEES=14

# PostgreSQL, uniquement si vous quittez SQLite un jour. Tant que cette
# variable est absente, la base est le fichier SQLite ci-dessus.
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/gachamath
